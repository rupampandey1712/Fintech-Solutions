# Local development values only. Replace secrets outside source control.
POSTGRES_DB=fincore
POSTGRES_USER=fincore
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql+psycopg://fincore:local-only-change-me@localhost:5432/fincore
REDIS_URL=redis://localhost:6379/0
PYTHON_API_URL=http://localhost:8000
DOTNET_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:8000
ASPNETCORE_ENVIRONMENT=Development
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_SIGNING_KEY=development-only-change-this-key
JWT_ISSUER=fincore
JWT_AUDIENCE=fincore-client
DEFAULT_LIMIT_PER_TRANSACTION_MINOR=10000000
DEFAULT_LIMIT_DAILY_MINOR=50000000
DEFAULT_LIMIT_WEEKLY_MINOR=100000000
DEFAULT_LIMIT_MONTHLY_MINOR=200000000
BENEFICIARY_COOLING_SECONDS=86400
KYC_STORAGE_PATH=data/kyc-documents
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
RATE_LIMIT_ENABLED=true
# Largest accepted request body, in bytes (both APIs). Must fit a base64-encoded 5 MiB KYC document.
MAX_REQUEST_BODY_BYTES=8388608
# Passwords refused at registration, one per line, checked through a Bloom filter (both APIs).
# Empty uses the bundled list of common patterns; point it at a breached-password corpus.
COMMON_PASSWORDS_PATH=
# Fraud investigator agent (Python: LangGraph, .NET: Agent Framework), both on Google Gemini.
# Leave GEMINI_API_KEY empty to keep the agent switched off. Get a key at aistudio.google.com.
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.5-flash
# Model turns per investigation, and its wall-clock budget.
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=90
# Investigations per minute per user; each one makes several paid model calls.
RATE_LIMIT_AGENT_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Login attempts per account (any IP) per minute; stops password guessing spread across IPs.
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_PAYMENT_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=100
ADMIN_EMAIL=
ADMIN_PASSWORD=
REFRESH_TOKEN_LIFETIME_DAYS=30
# Settlement fee per settled payment, in basis points (25 = 0.25%).
SETTLEMENT_FEE_BPS=25
# Periodic reconciliation by the background worker; the API endpoint always allows manual runs.
RECONCILIATION_SCHEDULE_ENABLED=false
RECONCILIATION_INTERVAL_SECONDS=3600
# Where generated CSV reports are stored when STORAGE_PROVIDER=filesystem.
REPORT_STORAGE_PATH=data/reports
# Messaging: "servicebus" (Azure Service Bus emulator in Docker) or "inline" (no broker).
MESSAGE_PROVIDER=servicebus
SERVICEBUS_SQL_PASSWORD=Local_only_Change-me_1
# Storage for KYC documents: "blob" (Azurite in Docker) or "filesystem".
STORAGE_PROVIDER=blob
# Host ports. Containers talk over the compose network, so these only matter for host tools;
# move any that collide with other stacks on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
SERVICEBUS_AMQP_HOST_PORT=5673
SERVICEBUS_HTTP_HOST_PORT=5301
AZURITE_BLOB_HOST_PORT=10010
PYTHON_API_HOST_PORT=8000
DOTNET_API_HOST_PORT=5000
FRONTEND_HOST_PORT=5173
OBSERVABILITY_HOST_PORT=18888

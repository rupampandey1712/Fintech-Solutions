# Test-environment template. The suites read these exact variable names:
# * python-backend/tests: FINCORE_TEST_DATABASE_URL (gates the pytest integration tests)
# * dotnet-backend/tests: FINCORE_TEST_CONNECTION_STRING (gates the xUnit integration tests)
# Create the databases first — the suites create tables but never create databases:
#   python-backend: alembic upgrade head  (with DATABASE_URL set to the python URL below)
#   The .NET tests expect the same schema; point them at a second database and apply the
#   Alembic migrations there too, or share one database between both suites.
#
# Integration tests are skipped when the variable is unset, so unit tests always run.

APP_ENV=test

# Python backend (pytest) — SQLAlchemy asyncpg URL.
FINCORE_TEST_DATABASE_URL=postgresql+asyncpg://fincore:fincore-test@localhost:5432/fincore_test
DATABASE_URL=postgresql+asyncpg://fincore:fincore-test@localhost:5432/fincore_test

# .NET backend (xUnit) — Npgsql connection string.
FINCORE_TEST_CONNECTION_STRING=Host=localhost;Port=5432;Database=fincore_test;Username=fincore;Password=fincore-test

# Optional: live cross-backend contract tests (tests/test_contract.py). Set both base URLs
# to running instances of the two APIs.
FINCORE_PYTHON_URL=
FINCORE_DOTNET_URL=

VITE_API_URL=http://localhost:8000

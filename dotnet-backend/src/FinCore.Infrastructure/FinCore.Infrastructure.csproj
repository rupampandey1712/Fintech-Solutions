<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.25.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled common-password list; identical to python-backend/app/resources/common_passwords.txt. -->
    <EmbeddedResource Include="Resources/common_passwords.txt" LogicalName="FinCore.Infrastructure.Resources.common_passwords.txt" />
    <!-- Fraud investigator instructions; identical to python-backend/app/resources/fraud_investigator_prompt.txt. -->
    <EmbeddedResource Include="Resources/fraud_investigator_prompt.txt" LogicalName="FinCore.Infrastructure.Resources.fraud_investigator_prompt.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FinCore.Domain/FinCore.Domain.csproj" />
    <ProjectReference Include="../FinCore.Application/FinCore.Application.csproj" />
  </ItemGroup>
</Project>
